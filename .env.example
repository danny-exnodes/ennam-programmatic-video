# Đạo diễn AI (Claude)
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-5-5
# Prompt caching cho đạo diễn (mặc định bật; 0 = tắt để đo đối chứng)
# DIRECTOR_PROMPT_CACHE=1
# Số job đạo diễn chạy đồng thời (phần vượt xếp hàng FIFO; render luôn chạy tuần tự)
# DIRECTOR_CONCURRENCY=2
# Chỉ cho scripts/test-jobs.js: bật kind job giả + POST /api/test/jobs. KHÔNG bật trên server thật.
# JOBS_TEST_KINDS=0

# Mật khẩu chung cũ (Basic Auth). Chưa có tài khoản → dùng mật khẩu này cho cả team.
# Đã có tài khoản (npm run user:add) → còn được chấp nhận 30 ngày kể từ tài khoản đầu tiên, sau đó bị bỏ.
# Bỏ trống + chưa có tài khoản = không yêu cầu đăng nhập.
APP_PASSWORD=
# Cookie phiên có cờ Secure: 1 = luôn bật; bỏ trống = tự bật khi request qua HTTPS / X-Forwarded-Proto: https
# COOKIE_SECURE=
# Sau reverse proxy / Cloudflare Tunnel: tin X-Forwarded-For để rate limit đăng nhập theo IP thật (vd. loopback hoặc 1)
# TRUST_PROXY=
# Thời gian cache users.json (ms): khoá tài khoản bằng cách sửa file / CLI có hiệu lực trong khoảng này (mặc định 30000)
# AUTH_CACHE_MS=30000
# Token cá nhân (ems_…) cho script dev chạy ở process riêng (frame/sheet/bench) khi server đã bật tài khoản
# EMS_TOKEN=

PORT=5173
DATA_DIR=./data
# RENDER_WORKERS=4
# Cache đoạn render mỗi dự án (MB, dọn theo LRU; 0 = tắt cache)
# RENDER_CACHE_MAX_MB=2000
# CHROME_PATH=/usr/bin/chromium

# Giọng đọc AI (tuỳ chọn)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=

# Thư viện chất liệu có giấy phép (tuỳ chọn) — npm run library
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
